# ── DocIntel — environment variables ───────────────────────────────────
# Copy to .env and fill in. Keep .env out of version control.

# Pinecone — dense + sparse indexes, hosted embeddings, fallback reranker
PINECONE_API_KEY=
# Dense index. Auto-created on startup with the right dimension for the provider.
PINECONE_INDEX_NAME=docintel-dense
# Sparse index: create once in the console as vector_type=sparse, metric=dotproduct.
PINECONE_SPARSE_INDEX_NAME=docintel-sparse
# Optional: isolate this corpus inside shared indexes.
PINECONE_NAMESPACE=docintel

# Dense embeddings: "pinecone" (llama-text-embed-v2, 1024-dim, no daily cap — the
# benchmarked setup) or "gemini" (gemini-embedding-2-preview, 3072-dim; the free
# tier caps it at 1,000 chunks/day).
EMBEDDING_PROVIDER=pinecone

# Google Gemini — answer generation (and embeddings if EMBEDDING_PROVIDER=gemini)
GOOGLE_API_KEY=
GENERATION_MODEL=gemini-2.5-flash
# Tried in order if the primary model is rate-limited (free tier: 5 req/min).
GENERATION_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-3.1-flash-lite

# Cohere — primary reranker (rerank-v3.5). Falls back to Pinecone's
# bge-reranker-v2-m3 if Cohere is unavailable or rate-limited.
COHERE_API_KEY=

# Optional: fuse reranker order with retrieval order (better rank-1, slightly
# lower top-5 coverage on QASPER; see eval/results/RESULTS.md). Default off.
RERANK_FUSION=0
